# Thresh environment — copy to .env and adjust. Never commit .env.

# Postgres (ADR 0007). Local dev default matches docker-compose.yml.
DATABASE_URL=postgres://thresh:thresh@localhost:5432/thresh?sslmode=disable

# Agent sidecar location, as the backend sees it.
AGENT_BASE_URL=http://localhost:8001

# Backend listen address.
BACKEND_ADDR=:8080

# Dev mode: verification links land in the server log (pilot has no mail server).
DEV_MODE=true
MAIL_SINK=log

# Web: where the Nuxt app finds the backend.
NUXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080

# Agent sidecar listen address.
AGENT_HOST=127.0.0.1
AGENT_PORT=8001
