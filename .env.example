# Thresh environment — copy to .env and adjust. Never commit .env.

# Postgres (ADR 0007). Local dev default matches docker-compose.yml.
DATABASE_URL=postgres://thresh:thresh@localhost:5432/thresh?sslmode=disable

# Agent sidecar location, as the backend sees it.
AGENT_BASE_URL=http://localhost:8001

# Backend listen address.
BACKEND_ADDR=:8080

# Dev mode: verification links land in the server log (pilot has no mail server).
DEV_MODE=true
MAIL_SINK=log

# Bootstrap (ticket 02): the first Platform Admin and initial TOS version are
# seeded at backend startup. Idempotent — existing rows win. Defaults below;
# override for real deployments.
BOOTSTRAP_ADMIN_EMAIL=admin@thresh.dev
BOOTSTRAP_ADMIN_PASSWORD=thresh-admin
BOOTSTRAP_TOS_VERSION=1.0
BOOTSTRAP_TOS_BODY=Thresh Terms of Service (pilot). Accept to share and commission data under pilot ground rules.

# Web: where the Nuxt app finds the backend.
NUXT_PUBLIC_BACKEND_BASE_URL=http://localhost:8080

# Object storage (ADR 0006 — server-side S3 only; ticket 04). Matches the
# compose MinIO below. Leave S3_ENDPOINT_URL empty to run without the asset
# endpoints (storage failures then refuse loudly, never silently).
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=thresh-assets
S3_ACCESS_KEY_ID=thresh
S3_SECRET_KEY=thresh-minio

# Pseudonym map (ticket 05, ADR 0005): key for the HMAC that protects stored
# identifiers. Optional in dev (the database URL keys it as a fallback); set
# a distinct secret for production. Rotating it re-mints every pseudonym.
#PSEUDONYM_HASH_KEY=

# Agent sidecar listen address.
AGENT_HOST=127.0.0.1
AGENT_PORT=8001

# Model gateway (ticket 07): the OpenAI-compatible endpoint the agent's
# clarification loop calls; every completion is metered and charged to the
# Request's budget by the backend. THRESH_MODEL_GATEWAY_KEY is required for
# real clarification (falls back to OPENAI_API_KEY); without a key the
# sidecar answers pings and refuses clarify turns with 503 — canned
# completions are never billed as real usage. To opt a dev/demo deployment
# into the fake gateway on purpose, set THRESH_MODEL_GATEWAY=fake.
THRESH_MODEL_GATEWAY_BASE_URL=https://api.openai.com/v1
#THRESH_MODEL_GATEWAY_KEY=
THRESH_MODEL=gpt-4o-mini
#THRESH_MODEL_GATEWAY=fake
